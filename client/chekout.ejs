<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finalizar Compra - QualiteApps</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --roxo-vivo: #8A2BE2;
            --azul-tech: #00B4D8;
            --verde-fresh: #00C853;
            --preto-profundo: #121212;
            --cinza-claro: #f5f5f5;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: var(--preto-profundo);
            color: white;
            margin: 0;
            line-height: 1.6;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 30px 20px;
        }

        .checkout-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .checkout-header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            background: linear-gradient(90deg, var(--roxo-vivo), var(--azul-tech));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .checkout-header p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1.1rem;
        }

        .checkout-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        @media (max-width: 768px) {
            .checkout-grid {
                grid-template-columns: 1fr;
            }
        }

        .order-summary {
            background: rgba(30, 30, 30, 0.7);
            border-radius: 15px;
            padding: 30px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .order-summary h2 {
            margin-top: 0;
            font-size: 1.8rem;
            color: var(--azul-tech);
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 15px;
        }

        .plan-details {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .plan-icon {
            font-size: 2.5rem;
            color: var(--roxo-vivo);
        }

        .plan-info h3 {
            margin: 0;
            font-size: 1.5rem;
        }

        .plan-info p {
            margin: 5px 0 0;
            color: rgba(255, 255, 255, 0.7);
        }

        .plan-price {
            font-size: 2rem;
            font-weight: 700;
            margin: 20px 0;
            text-align: right;
        }

        .features-list {
            list-style: none;
            padding: 0;
            margin: 30px 0;
        }

        .features-list li {
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .features-list li:last-child {
            border-bottom: none;
        }

        .feature-icon {
            color: var(--verde-fresh);
        }

        .payment-methods {
            margin-top: 30px;
        }

        .payment-methods h3 {
            margin-bottom: 15px;
            font-size: 1.3rem;
        }

        .payment-options {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .payment-option {
            flex: 1;
            min-width: 120px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }

        .payment-option:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: var(--azul-tech);
        }

        .payment-option.active {
            background: rgba(138, 43, 226, 0.2);
            border-color: var(--roxo-vivo);
        }

        .payment-option i {
            font-size: 2rem;
            margin-bottom: 10px;
            display: block;
        }

        .payment-form {
            margin-top: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .form-group input, .form-group select {
            width: 100%;
            padding: 12px 15px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            color: white;
            font-size: 1rem;
            transition: all 0.3s;
        }

        .form-group input:focus, .form-group select:focus {
            outline: none;
            border-color: var(--azul-tech);
            background: rgba(255, 255, 255, 0.15);
        }

        .server-selection {
            margin-bottom: 30px;
        }

        .server-selection select {
            width: 100%;
            padding: 12px 15px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            color: white;
            font-size: 1rem;
        }

        .checkout-button {
            width: 100%;
            padding: 16px;
            background: linear-gradient(45deg, var(--roxo-vivo), #9B30FF);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .checkout-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        }

        .checkout-button:active {
            transform: translateY(0);
        }

        .security-info {
            margin-top: 30px;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.6);
            text-align: center;
        }

        .security-info i {
            color: var(--verde-fresh);
            margin-right: 5px;
        }

        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            display: none;
        }

        .loading-spinner {
            width: 50px;
            height: 50px;
            border: 5px solid rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            border-top-color: var(--roxo-vivo);
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="checkout-header">
            <h1>Finalizar Compra</h1>
            <p>Preencha os detalhes abaixo para ativar seu plano premium</p>
        </div>

        <div class="checkout-grid">
            <div class="order-summary">
                <h2>Resumo do Pedido</h2>
                
                <div class="plan-details">
                    <i class="fas fa-crown plan-icon" id="plan-icon"></i>
                    <div class="plan-info">
                        <h3 id="plan-name">Plano Epro Completo</h3>
                        <p id="plan-description">Soluções completas para seu servidor Discord</p>
                    </div>
                </div>
                
                <div class="plan-price" id="plan-price">R$ 6,99/mês</div>
                
                <ul class="features-list" id="features-list">
                    <li><i class="fas fa-check feature-icon"></i> Vendas Super Tecnologias</li>
                    <li><i class="fas fa-check feature-icon"></i> Tickets Avançados</li>
                    <li><i class="fas fa-check feature-icon"></i> Sistemas Completos</li>
                    <li><i class="fas fa-check feature-icon"></i> Suporte Prioritário 24/7</li>
                    <li><i class="fas fa-check feature-icon"></i> Logs detalhadas</li>
                </ul>
                
                <div class="security-info">
                    <i class="fas fa-lock"></i> Sua compra está segura conosco. Dados criptografados.
                </div>
            </div>
            
            <div class="payment-section">
                <div class="server-selection">
                    <h3>Selecione seu servidor</h3>
                    <select id="server-select" class="form-control">
                        <option value="">Carregando servidores...</option>
                    </select>
                </div>
                
                <div class="payment-methods">
                    <h3>Método de Pagamento</h3>
                    <div class="payment-options">
                        <div class="payment-option active" data-method="mercadopago">
                            <i class="fas fa-credit-card"></i>
                            <span>Cartão</span>
                        </div>
                        <div class="payment-option" data-method="pix">
                            <i class="fas fa-qrcode"></i>
                            <span>PIX</span>
                        </div>
                    </div>
                    
                    <div class="payment-form" id="credit-card-form">
                        <div class="form-group">
                            <label for="card-number">Número do Cartão</label>
                            <input type="text" id="card-number" placeholder="1234 5678 9012 3456">
                        </div>
                        
                        <div class="form-group">
                            <label for="card-name">Nome no Cartão</label>
                            <input type="text" id="card-name" placeholder="Nome como no cartão">
                        </div>
                        
                        <div class="form-row" style="display: flex; gap: 15px;">
                            <div class="form-group" style="flex: 1;">
                                <label for="card-expiry">Validade</label>
                                <input type="text" id="card-expiry" placeholder="MM/AA">
                            </div>
                            
                            <div class="form-group" style="flex: 1;">
                                <label for="card-cvv">CVV</label>
                                <input type="text" id="card-cvv" placeholder="123">
                            </div>
                        </div>
                    </div>
                    
                    <div class="payment-form" id="pix-form" style="display: none;">
                        <p>Após confirmar a compra, você receberá um QR Code para realizar o pagamento via PIX.</p>
                    </div>
                    
                    <button class="checkout-button" id="checkout-button">
                        <i class="fas fa-lock"></i> Finalizar Compra
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="loading-overlay" id="loading-overlay">
        <div class="loading-spinner"></div>
        <p>Processando seu pagamento...</p>
    </div>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Obter parâmetros da URL
            const urlParams = new URLSearchParams(window.location.search);
            const plan = urlParams.get('plan') || 'epro';
            
            // Atualizar informações do plano
            updatePlanInfo(plan);
            
            // Carregar servidores do usuário
            loadUserServers();
            
            // Configurar seleção de método de pagamento
            document.querySelectorAll('.payment-option').forEach(option => {
                option.addEventListener('click', function() {
                    document.querySelectorAll('.payment-option').forEach(opt => {
                        opt.classList.remove('active');
                    });
                    this.classList.add('active');
                    
                    document.querySelectorAll('.payment-form').forEach(form => {
                        form.style.display = 'none';
                    });
                    
                    const method = this.getAttribute('data-method');
                    document.getElementById(`${method}-form`).style.display = 'block';
                });
            });
            
            // Configurar botão de finalizar compra
            document.getElementById('checkout-button').addEventListener('click', processPayment);
        });
        
        function updatePlanInfo(plan) {
            const plans = {
                'basic': {
                    name: 'Bot de Atendimento',
                    description: 'Sistema básico para atendimento automático',
                    price: 'R$ 3,00/mês',
                    icon: 'fas fa-robot',
                    features: [
                        'Sistema de Tickets',
                        'Respostas Automatizadas',
                        'Painel de Controle',
                        'Suporte profissional',
                        'Totalmente personalizável',
                        'Logs detalhados'
                    ]
                },
                'epro': {
                    name: 'Epro Completo',
                    description: 'Soluções completas para seu servidor Discord',
                    price: 'R$ 6,99/mês',
                    icon: 'fas fa-crown',
                    features: [
                        'Vendas Super Tecnologias',
                        'Tickets Avançados',
                        'Sistemas Completos',
                        'Suporte Prioritário 24/7',
                        'Logs detalhadas',
                        'Qrcode e pagamentos personalizáveis',
                        'Integração com Mercadopago e EFI'
                    ]
                }
            };
            
            const selectedPlan = plans[plan] || plans['epro'];
            
            document.getElementById('plan-name').textContent = selectedPlan.name;
            document.getElementById('plan-description').textContent = selectedPlan.description;
            document.getElementById('plan-price').textContent = selectedPlan.price;
            document.getElementById('plan-icon').className = `${selectedPlan.icon} plan-icon`;
            
            const featuresList = document.getElementById('features-list');
            featuresList.innerHTML = '';
            
            selectedPlan.features.forEach(feature => {
                const li = document.createElement('li');
                li.innerHTML = `<i class="fas fa-check feature-icon"></i> ${feature}`;
                featuresList.appendChild(li);
            });
        }
        
        async function loadUserServers() {
            try {
                const response = await fetch('/api/auth/current');
                if (!response.ok) throw new Error('Erro ao carregar usuário');
                
                const user = await response.json();
                
                // TODO: Carregar servidores do Discord do usuário
                // Por enquanto, vamos simular
                const serverSelect = document.getElementById('server-select');
                serverSelect.innerHTML = '';
                
                const defaultOption = document.createElement('option');
                defaultOption.value = '';
                defaultOption.textContent = 'Selecione um servidor';
                serverSelect.appendChild(defaultOption);
                
                // Servidores simulados - na implementação real, você buscaria da API do Discord
                const mockServers = [
                    { id: '1', name: 'Meu Servidor Principal' },
                    { id: '2', name: 'Comunidade de Jogos' },
                    { id: '3', name: 'Servidor de Suporte' }
                ];
                
                mockServers.forEach(server => {
                    const option = document.createElement('option');
                    option.value = server.id;
                    option.textContent = server.name;
                    serverSelect.appendChild(option);
                });
                
            } catch (error) {
                console.error('Erro ao carregar servidores:', error);
                document.getElementById('server-select').innerHTML = 
                    '<option value="">Erro ao carregar servidores</option>';
            }
        }
        
        async function processPayment() {
            const serverSelect = document.getElementById('server-select');
            const selectedServer = serverSelect.value;
            
            if (!selectedServer) {
                alert('Por favor, selecione um servidor');
                return;
            }
            
            const selectedMethod = document.querySelector('.payment-option.active').getAttribute('data-method');
            const plan = new URLSearchParams(window.location.search).get('plan') || 'epro';
            
            document.getElementById('loading-overlay').style.display = 'flex';
            
            try {
                // Criar pagamento no backend
                const response = await fetch('/api/payments/create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        plan,
                        serverId: selectedServer,
                        method: selectedMethod
                    })
                });
                
                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.error || 'Erro ao processar pagamento');
                }
                
                const data = await response.json();
                
                // Redirecionar para o link de pagamento
                window.location.href = data.paymentLink;
                
            } catch (error) {
                console.error('Erro no pagamento:', error);
                alert(`Erro: ${error.message}`);
                document.getElementById('loading-overlay').style.display = 'none';
            }
        }
    </script>
</body>
</html>