    <script>
        // Efeito de digitação no hero
        const typingText = document.getElementById('typing-text');
        const phrases = [
            "Crescimento Garantido",
            "Tecnologia Avançada",
            "Suporte 24/7",
            "Ferramentas Profissionais"
        ];
        let phraseIndex = 0;
        let charIndex = 0;
        let isDeleting = false;
        let isEnd = false;

        function typeWriter() {
            const currentPhrase = phrases[phraseIndex];
            
            if (isDeleting) {
                typingText.textContent = currentPhrase.substring(0, charIndex - 1);
                charIndex--;
            } else {
                typingText.textContent = currentPhrase.substring(0, charIndex + 1);
                charIndex++;
            }

            if (!isDeleting && charIndex === currentPhrase.length) {
                isEnd = true;
                setTimeout(() => {
                    isDeleting = true;
                }, 2000);
            } else if (isDeleting && charIndex === 0) {
                isDeleting = false;
                phraseIndex = (phraseIndex + 1) % phrases.length;
            }

            const speed = isDeleting ? 50 : isEnd ? 100 : 150;
            setTimeout(typeWriter, speed);
            
            if (isEnd) isEnd = false;
        }

        // Inicia o efeito de digitação
        setTimeout(typeWriter, 500);

        // Efeito de scroll nos cards
        const plansContainer = document.getElementById('plans-container');
        let isDown = false;
        let startX;
        let scrollLeft;

        plansContainer.addEventListener('mousedown', (e) => {
            isDown = true;
            plansContainer.style.cursor = 'grabbing';
            startX = e.pageX - plansContainer.offsetLeft;
            scrollLeft = plansContainer.scrollLeft;
        });

        plansContainer.addEventListener('mouseleave', () => {
            isDown = false;
            plansContainer.style.cursor = 'grab';
        });

        plansContainer.addEventListener('mouseup', () => {
            isDown = false;
            plansContainer.style.cursor = 'grab';
        });

        plansContainer.addEventListener('mousemove', (e) => {
            if(!isDown) return;
            e.preventDefault();
            const x = e.pageX - plansContainer.offsetLeft;
            const walk = (x - startX) * 1; // Aumenta a resistência
            plansContainer.scrollLeft = scrollLeft - walk;
        });

        // Adiciona resistência ao scroll com mouse wheel
        plansContainer.addEventListener('wheel', (e) => {
            e.preventDefault();
            plansContainer.scrollLeft += e.deltaY * 0.5; // Reduz a velocidade
        });

        // Snap ao soltar o arraste
        plansContainer.addEventListener('mouseup', () => {
            const cardWidth = document.querySelector('.plan-card').offsetWidth + 30; // Largura do card + gap
            const scrollPosition = plansContainer.scrollLeft;
            const closestCard = Math.round(scrollPosition / cardWidth);
            plansContainer.scrollTo({
                left: closestCard * cardWidth,
                behavior: 'smooth'
            });
        });

        // Observador de interseção para animações
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate__animated', 'animate__fadeInUp');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.plan-card, .feature-card').forEach(card => {
            observer.observe(card);
        });

        // Efeito de hover glow nos cards
        document.querySelectorAll('.plan-card').forEach(card => {
            const glow = document.createElement('div');
            glow.style.position = 'absolute';
            glow.style.borderRadius = '20px';
            glow.style.top = '0';
            glow.style.left = '0';
            glow.style.width = '100%';
            glow.style.height = '100%';
            glow.style.opacity = '0';
            glow.style.transition = 'opacity 0.3s';
            glow.style.pointerEvents = 'none';
            glow.style.zIndex = '-1';
            
            if (card.classList.contains('popular')) {
                glow.style.boxShadow = '0 0 50px rgba(138, 43, 226, 0.6)';
            } else if (card.classList.contains('plan-card') && card === document.querySelectorAll('.plan-card')[1]) {
                glow.style.boxShadow = '0 0 50px rgba(0, 180, 216, 0.6)';
            } else {
                glow.style.boxShadow = '0 0 50px rgba(0, 200, 83, 0.6)';
            }
            
            card.appendChild(glow);
            
            card.addEventListener('mouseenter', () => {
                glow.style.opacity = '1';
            });
            
            card.addEventListener('mouseleave', () => {
                glow.style.opacity = '0';
            });
        });

        // Efeito de confete nos botões
        document.querySelectorAll('.cta-button').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                
                // Efeito visual temporário
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = '';
                }, 200);
                
                setTimeout(() => {
                    if (this.getAttribute('href')) {
                        window.location.href = this.getAttribute('href');
                    }
                }, 300);
            });
        });
    </script>
