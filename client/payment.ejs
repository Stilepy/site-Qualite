<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Status do Pagamento - QualiteApps</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --roxo-vivo: #8A2BE2;
            --azul-tech: #00B4D8;
            --verde-fresh: #00C853;
            --preto-profundo: #121212;
            --cinza-claro: #f5f5f5;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: var(--preto-profundo);
            color: white;
            margin: 0;
            line-height: 1.6;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 50px 20px;
            text-align: center;
        }

        .status-card {
            background: rgba(30, 30, 30, 0.7);
            border-radius: 15px;
            padding: 40px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            margin-bottom: 30px;
        }

        .status-icon {
            font-size: 5rem;
            margin-bottom: 20px;
        }

        .status-icon.approved {
            color: var(--verde-fresh);
            animation: bounce 1s;
        }

        .status-icon.pending {
            color: var(--azul-tech);
            animation: pulse 2s infinite;
        }

        .status-icon.rejected {
            color: #e74c3c;
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        p {
            font-size: 1.2rem;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 30px;
        }

        .order-details {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            padding: 20px;
            margin: 30px 0;
            text-align: left;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-label {
            color: rgba(255, 255, 255, 0.6);
        }

        .detail-value {
            font-weight: 500;
        }

        .btn {
            display: inline-block;
            padding: 15px 30px;
            border-radius: 10px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s;
            margin: 10px;
        }

        .btn-primary {
            background: linear-gradient(45deg, var(--roxo-vivo), #9B30FF);
            color: white;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        }

        .btn:active {
            transform: translateY(0);
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {transform: translateY(0);}
            40% {transform: translateY(-30px);}
            60% {transform: translateY(-15px);}
        }

        @keyframes pulse {
            0% {transform: scale(1);}
            50% {transform: scale(1.1);}
            100% {transform: scale(1);}
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="status-card">
            <i class="fas fa-check-circle status-icon approved" id="status-icon"></i>
            <h1 id="status-title">Pagamento Aprovado!</h1>
            <p id="status-message">Seu plano premium foi ativado com sucesso. Obrigado por escolher a QualiteApps!</p>
            
            <div class="order-details">
                <div class="detail-row">
                    <span class="detail-label">Plano:</span>
                    <span class="detail-value" id="plan-name">Epro Completo</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Valor:</span>
                    <span class="detail-value" id="plan-price">R$ 6,99</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Método:</span>
                    <span class="detail-value" id="payment-method">Cartão de Crédito</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Servidor:</span>
                    <span class="detail-value" id="server-name">Meu Servidor Principal</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">ID da Transação:</span>
                    <span class="detail-value" id="transaction-id">MP123456789</span>
                </div>
            </div>
            
            <a href="/dashboard" class="btn btn-primary">
                <i class="fas fa-tachometer-alt"></i> Ir para o Dashboard
            </a>
            <a href="/" class="btn btn-secondary">
                <i class="fas fa-home"></i> Voltar para Home
            </a>
        </div>
    </div>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Obter status da URL
            const urlParams = new URLSearchParams(window.location.search);
            const status = urlParams.get('status') || 'approved';
            const paymentId = urlParams.get('payment_id');
            
            // Atualizar UI baseada no status
            updateStatusUI(status);
            
            // Se tivermos um paymentId, buscar detalhes do pagamento
            if (paymentId) {
                fetchPaymentDetails(paymentId);
            }
        });
        
        function updateStatusUI(status) {
            const statusIcon = document.getElementById('status-icon');
            const statusTitle = document.getElementById('status-title');
            const statusMessage = document.getElementById('status-message');
            
            statusIcon.className = 'fas status-icon';
            
            switch(status) {
                case 'approved':
                    statusIcon.classList.add('fa-check-circle', 'approved');
                    statusTitle.textContent = 'Pagamento Aprovado!';
                    statusMessage.textContent = 'Seu plano premium foi ativado com sucesso. Obrigado por escolher a QualiteApps!';
                    break;
                    
                case 'pending':
                    statusIcon.classList.add('fa-clock', 'pending');
                    statusTitle.textContent = 'Pagamento Pendente';
                    statusMessage.textContent = 'Seu pagamento está sendo processado. Você receberá uma notificação quando for aprovado.';
                    break;
                    
                case 'rejected':
                    statusIcon.classList.add('fa-times-circle', 'rejected');
                    statusTitle.textContent = 'Pagamento Recusado';
                    statusMessage.textContent = 'Houve um problema com seu pagamento. Por favor, tente novamente ou entre em contato com o suporte.';
                    break;
                    
                default:
                    statusIcon.classList.add('fa-question-circle', 'pending');
                    statusTitle.textContent = 'Status Desconhecido';
                    statusMessage.textContent = 'Não foi possível determinar o status do seu pagamento. Por favor, entre em contato com o suporte.';
            }
        }
        
        async function fetchPaymentDetails(paymentId) {
            try {
                const response = await fetch(`/api/payments/status/${paymentId}`);
                if (!response.ok) throw new Error('Erro ao buscar detalhes do pagamento');
                
                const payment = await response.json();
                
                // Atualizar detalhes na UI
                document.getElementById('plan-name').textContent = 
                    payment.plan === 'basic' ? 'Bot de Atendimento' : 'Epro Completo';
                
                document.getElementById('plan-price').textContent = 
                    `R$ ${payment.amount.toFixed(2).replace('.', ',')}`;
                
                document.getElementById('payment-method').textContent = 
                    payment.method === 'mercadopago' ? 'Cartão de Crédito' : 'PIX';
                
                document.getElementById('transaction-id').textContent = 
                    payment.transactionId || 'N/A';
                
                // TODO: Buscar nome do servidor se necessário
                
            } catch (error) {
                console.error('Erro ao buscar detalhes:', error);
            }
        }
    </script>
</body>
</html>